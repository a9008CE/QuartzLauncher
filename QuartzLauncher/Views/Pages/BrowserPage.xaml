<Page x:Class="QuartzLauncher.Views.Pages.BrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Background="Transparent">
    <Grid Margin="24,18" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Top" Height="34">
            <Button Content="返回" FontSize="12" Padding="8,4"
                    Width="56" Height="34" Style="{DynamicResource BtnBase}"
                    ToolTip="返回服务器列表" Click="Back_Click"/>
            <TextBlock Text="内置浏览器" Style="{DynamicResource PageTitle}"
                       FontSize="22" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="内容可能短暂下移，向下滑动即可恢复"
                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                       Margin="10,4,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Top" Height="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="后退" Padding="8,4" Style="{DynamicResource BtnBase}" Width="56" Height="34"
                    ToolTip="后退" Click="BackNavigation_Click">
            </Button>
            <Button Grid.Column="1" Content="前进" Padding="8,4" Style="{DynamicResource BtnBase}" Width="56" Height="34"
                    ToolTip="前进" Click="ForwardNavigation_Click" Margin="6,0,0,0">
            </Button>
            <Button Grid.Column="2" Content="刷新" Padding="8,4" Style="{DynamicResource BtnBase}" Width="56" Height="34"
                    ToolTip="刷新" Click="Refresh_Click" Margin="6,0,0,0">
            </Button>
            <Button Grid.Column="3" Content="停止" Padding="8,4" Style="{DynamicResource BtnBase}" Width="56" Height="34"
                    ToolTip="停止加载" Click="Stop_Click" Margin="6,0,10,0">
            </Button>
            <TextBox Grid.Column="4" x:Name="AddressBox" Height="34" FontSize="14"
                     VerticalContentAlignment="Center" Padding="10,0"
                     KeyDown="AddressBox_KeyDown"/>
            <Button Grid.Column="5" Content="转到" Style="{DynamicResource BtnPrimary}"
                    Height="34" Padding="14,4" Click="Navigate_Click" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="6" x:Name="StatusText" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="0"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid>
                <wv2:WebView2 x:Name="Browser"/>
                <Image x:Name="BrowserSnapshot" Stretch="Fill" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Page>

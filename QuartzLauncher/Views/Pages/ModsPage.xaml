<Page x:Class="QuartzLauncher.Views.Pages.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      AllowDrop="True" Drop="Page_Drop" DragOver="Page_DragOver">
    <Grid Margin="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="MODS" Style="{DynamicResource PageEyebrow}"/>
            <TextBlock Text="Mod 管理" Style="{DynamicResource PageTitle}"/>
            <TextBlock x:Name="SubtitleText" Text="管理已安装的 Mod，支持启用、禁用与删除。"
                       Style="{DynamicResource PageSubtitle}"/>
        </StackPanel>

        <!-- 搜索 + 筛选 + 操作栏 -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,0,0,8" Padding="14,10">
            <StackPanel>
                <!-- 搜索框 -->
                <TextBox x:Name="SearchBox" Height="32" FontSize="13"
                         Background="{DynamicResource InputBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1" Padding="8,4"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Tag" Value="搜索 Mod 名称 / 文件名..."/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- 筛选 + 操作 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 筛选按钮 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton x:Name="FilterAll" Content="全部" IsChecked="True"
                                     Click="Filter_Click"
                                     Padding="10,4" Height="28" GroupName="Filter"/>
                        <RadioButton x:Name="FilterEnabled" Content="已启用"
                                     Click="Filter_Click"
                                     Padding="10,4" Height="28" Margin="4,0,0,0" GroupName="Filter"/>
                        <RadioButton x:Name="FilterDisabled" Content="已禁用"
                                     Click="Filter_Click"
                                     Padding="10,4" Height="28" Margin="4,0,0,0" GroupName="Filter"/>
                    </StackPanel>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="打开文件夹" Style="{DynamicResource BtnPrimary}"
                                Padding="10,4" Height="28" Click="OpenFolder_Click"/>
                        <Button Content="从文件安装" Style="{DynamicResource BtnBase}"
                                Padding="10,4" Height="28" Margin="6,0,0,0" Click="Import_Click"/>
                        <Button Content="全选" Style="{DynamicResource BtnBase}"
                                Padding="10,4" Height="28" Margin="6,0,0,0" Click="SelectAll_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Mod 列表 -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="4">
            <Grid>
                <TextBlock x:Name="EmptyHint"
                           Text="此版本没有已安装的 Mod&#x0a;&#x0a;拖拽 .jar 文件到此窗口即可导入"
                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" LineHeight="22"/>
                <ListBox x:Name="ModList" BorderThickness="0" Background="Transparent"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         />
            </Grid>
        </Border>

        <!-- 批量操作栏 -->
        <Border x:Name="BulkBar" Grid.Row="3" Style="{DynamicResource CardStyle}"
                Margin="0,8,0,0" Padding="14,8" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="BulkInfo" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="启用" Style="{DynamicResource BtnPrimary}" Padding="12,4"
                            Height="28" Click="BulkEnable_Click"/>
                    <Button Content="禁用" Style="{DynamicResource BtnBase}" Padding="12,4"
                            Height="28" Margin="6,0,0,0" Click="BulkDisable_Click"/>
                    <Button Content="删除" Style="{DynamicResource BtnDanger}" Padding="12,4"
                            Height="28" Margin="6,0,0,0" Click="BulkDelete_Click"/>
                    <Button Content="取消选择" Style="{DynamicResource BtnBase}" Padding="12,4"
                            Height="28" Margin="6,0,0,0" Click="ClearSelection_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>

<UserControl x:Class="QuartzLauncher.Views.Pages.JavaDownloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="820">
            <TextBlock Text="JAVA RUNTIMES" Style="{DynamicResource PageEyebrow}"/>
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="刷新列表" Style="{DynamicResource BtnBase}"
                        Padding="12,6" Click="Refresh_Click"/>
                <TextBlock Text="Java 下载" Style="{DynamicResource PageTitle}"/>
            </DockPanel>
            <TextBlock Text="下载并自动安装适用于 Windows x64 的 Temurin Java。支持从 Java 8 到当前可用版本。"
                       Style="{DynamicResource PageSubtitle}"/>

            <Border Style="{DynamicResource CardStyle}" Margin="0,8,0,16">
                <StackPanel>
                    <TextBlock Text="自动安装位置" Style="{DynamicResource SectionHeader}"/>
                    <TextBlock x:Name="InstallDirectoryText" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="安装完成后会自动加入 Java 列表，启动游戏时可按 Minecraft 版本直接匹配。已有版本可以重新安装以更新。"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Text="正在加载 Java 版本列表..." FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"
                       TextWrapping="Wrap"/>
            <ListBox x:Name="JavaList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardStyle}" Padding="14,11" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Windows x64 · HotSpot · JDK · {Binding FileName}"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="点击后下载并自动安装到 C 盘"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="下载并安装" Style="{DynamicResource BtnPrimary}"
                                        Padding="12,6" Tag="{Binding}" Click="Download_Click"
                                        VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>

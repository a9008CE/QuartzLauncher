<Page x:Class="QuartzLauncher.Views.Pages.SavesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24">
            <TextBlock Text="SAVES" Style="{DynamicResource PageEyebrow}"/>
            <TextBlock Text="存档管理" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="管理游戏世界的存档。" Style="{DynamicResource PageSubtitle}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="存档列表" Style="{DynamicResource SectionHeader}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="导入存档" Style="{DynamicResource BtnBase}" Padding="10,5"
                                        Click="Import_Click" Margin="0,0,6,0"/>
                                <Button Content="刷新" Style="{DynamicResource BtnBase}" Padding="10,5"
                                        Click="Refresh_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="HintText" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>
                        <ListBox x:Name="SaveList" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

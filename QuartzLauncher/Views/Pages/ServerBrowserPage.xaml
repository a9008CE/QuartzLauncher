<Page x:Class="QuartzLauncher.Views.Pages.ServerBrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid Margin="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
                <TextBox x:Name="SearchBox" Width="240" Height="30" Margin="0,0,10,0"
                         Padding="10,0" VerticalContentAlignment="Center"
                         ToolTip="搜索服务器名称、版本或介绍" TextChanged="SearchBox_TextChanged"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="刷新" Style="{DynamicResource BtnBase}" Padding="12,6" Click="Refresh_Click" Margin="0,0,8,0"/>
                    <Button x:Name="DomesticButton" Content="国内服务器" Style="{DynamicResource BtnBase}"
                            Padding="12,6" Click="Domestic_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ForeignButton" Content="国外服务器" Style="{DynamicResource BtnBase}"
                            Padding="12,6" Click="Foreign_Click"/>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="&#x2190;" FontFamily="Segoe UI Symbol" FontSize="10"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand"
                            Click="Back_Click" Margin="0,0,10,0"/>
                    <TextBlock Text="SERVERS" Style="{DynamicResource PageEyebrow}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="多人游戏服务器" Style="{DynamicResource PageTitle}"/>
                <TextBlock Text="自动获取 MC百科找服玩 的在线 Minecraft 服务器。" Style="{DynamicResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ServerPanel" MaxWidth="820" HorizontalAlignment="Stretch"/>
        </ScrollViewer>

        <Border x:Name="LoadingOverlay" Grid.Row="1" Background="Transparent"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="48" Height="48" ClipToBounds="False">
                    <Path x:Name="SpinnerPath" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 24,4 A 20,20 0 1 1 4,24">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                            </Style>
                        </Path.Style>
                        <Path.RenderTransform>
                            <RotateTransform Angle="0" CenterX="24" CenterY="24"/>
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
                <TextBlock Text="正在加载服务器列表" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                           Margin="0,14,0,0">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <StringAnimationUsingKeyFrames Storyboard.TargetProperty="Text"
                                        BeginTime="0:0:0">
                                        <DiscreteStringKeyFrame KeyTime="0:0:0" Value="正在加载服务器列表"/>
                                        <DiscreteStringKeyFrame KeyTime="0:0:0.5" Value="正在加载服务器列表."/>
                                        <DiscreteStringKeyFrame KeyTime="0:0:1.0" Value="正在加载服务器列表.."/>
                                        <DiscreteStringKeyFrame KeyTime="0:0:1.5" Value="正在加载服务器列表..."/>
                                    </StringAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="PreviousButton" Content="上一页" Style="{DynamicResource BtnBase}"
                    Padding="14,6" Click="Previous_Click"/>
            <TextBlock x:Name="PageText" Text="1 / 1" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="18,0"/>
            <Button x:Name="NextButton" Content="下一页" Style="{DynamicResource BtnBase}"
                    Padding="14,6" Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Page>

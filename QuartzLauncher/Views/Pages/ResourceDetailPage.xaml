<Page x:Class="QuartzLauncher.Views.Pages.ResourceDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,0,14">
        <StackPanel Margin="0,12,0,16">
            <Border Background="{DynamicResource CardSurfaceBrush}" CornerRadius="16" Padding="20"
                    Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CoverBorder" Width="160" Height="160" CornerRadius="14"
                            ClipToBounds="True"
                            Background="{DynamicResource InputBgBrush}">
                        <Grid>
                            <TextBlock x:Name="CoverFallback" FontSize="64" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="CoverImage" Stretch="Uniform" Opacity="0"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="OriginalNameText" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <WrapPanel x:Name="TagPanel" Margin="0,0,0,8"/>
                        <TextBlock x:Name="AuthorText" FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="StatsText" FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="McmodInfoHeader" Text="MC百科资料" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" Visibility="Collapsed"/>
            <Border x:Name="McmodInfoPanel" Background="{DynamicResource CardSurfaceBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel x:Name="McmodInfoContent"/>
            </Border>

            <TextBlock x:Name="IntroHeader" Text="介绍" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
            <TextBlock x:Name="IntroText" FontSize="13" LineHeight="21"
                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                       Opacity="0.92" Visibility="Collapsed"/>
            <ContentControl x:Name="IntroHtml" Visibility="Collapsed"/>

            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,14"/>
            <TextBlock x:Name="VersionLabel" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
            <TextBlock x:Name="VersionHint" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,10" Visibility="Collapsed"/>
            <StackPanel x:Name="VersionPicker" Visibility="Collapsed">
                <TextBlock Text="Minecraft 游戏版本" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="GameVersionCombo" Height="34" FontSize="12"
                          VerticalContentAlignment="Center" Margin="0,0,0,12"
                          Background="{DynamicResource InputBgBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          Foreground="{DynamicResource TextBrush}"
                          SelectionChanged="GameVersion_Changed"/>
                <TextBlock Text="加载器" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="LoaderCombo" Height="34" FontSize="12"
                          VerticalContentAlignment="Center" Margin="0,0,0,12"
                          Background="{DynamicResource InputBgBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          Foreground="{DynamicResource TextBrush}"
                          SelectionChanged="Loader_Changed"/>
                <TextBlock Text="文件版本" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="FileVersionCombo" Grid.Column="0" Height="34" MinWidth="220"
                              FontSize="12" VerticalContentAlignment="Center"
                              Background="{DynamicResource InputBgBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              SelectionChanged="FileVersion_Changed"/>
                    <Button x:Name="DownloadBtn" Grid.Column="2" Content="下载"
                            Style="{DynamicResource BtnPrimary}" Padding="16,4" FontSize="12"
                            Height="34" Cursor="Hand" Click="Download_Click"/>
                </Grid>
                <TextBlock x:Name="DependencyText" FontSize="11" LineHeight="17"
                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel x:Name="VersionCards" Margin="0,6,0,0"/>
            <TextBlock x:Name="NoVersionsText" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="McmodLinkBtn" Content="查看 MC百科完整资料" Style="{DynamicResource BtnBase}"
                        Padding="10,4" FontSize="11" Margin="0,0,8,0" Cursor="Hand"/>
                <Button x:Name="OfficialLinkBtn" Content="查看官方下载页面" Style="{DynamicResource BtnBase}"
                        Padding="10,4" FontSize="11" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
